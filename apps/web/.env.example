# Base URL of the NestJS API without a trailing slash.
# apiFetch prepends it to request paths, e.g. "https://<api>.onrender.com" + "/properties".
# NEXT_PUBLIC_* is inlined into the client bundle at build time (must be set at build on Vercel).
#
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:3001
#
# Production (set in Vercel project env, not committed):
# NEXT_PUBLIC_API_URL=https://<your-render-api>.onrender.com